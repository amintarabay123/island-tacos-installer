modules = ["nodejs-24", "postgresql-16", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 18184
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
VITE_ADMIN_PATH = "it-dav7dwn8"
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "orders@islandtacosbvi.com"
SMTP_FROM = "Island Tacos <orders@islandtacosbvi.com>"
TWILIO_FROM_NUMBER = "+14245448088"

[userenv.production]
VITE_CLERK_PROXY_URL = "https://order-direct-connect.replit.app/api/__clerk"
