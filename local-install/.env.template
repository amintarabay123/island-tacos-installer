# ─────────────────────────────────────────────────────────────────────────────
# Island Tacos — Local Server Configuration
# Copy this file to .env in the PROJECT ROOT and fill in every value.
# Lines starting with # are comments and are ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME
DATABASE_URL=postgresql://ituser:CHANGE_ME@localhost:5432/islandtacos

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# The LAN IP of this mini PC (find it with: ip addr  or  ipconfig)
# Used to register the ATH Móvil webhook and build the correct Clerk proxy URL.
PUBLIC_URL=http://192.168.1.50:3001

# Path to the built frontend (relative to project root — do not change)
SERVE_STATIC_PATH=./artifacts/island-tacos/dist/public

# ── Security ─────────────────────────────────────────────────────────────────
# Any long random string — keep it secret
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# POS login PINs (must match what staff already know)
ADMIN_PIN=SAME_AS_REPLIT
STAFF_PIN=SAME_AS_REPLIT

# ── Loyverse ─────────────────────────────────────────────────────────────────
LOYVERSE_API_TOKEN=SAME_AS_REPLIT

# ── ATH Móvil ────────────────────────────────────────────────────────────────
ATHMOVIL_PUBLIC_TOKEN=SAME_AS_REPLIT
ATHMOVIL_PRIVATE_TOKEN=SAME_AS_REPLIT

# ── Email (optional — for order confirmation emails) ─────────────────────────
SMTP_PASSWORD=SAME_AS_REPLIT

# ── Object Storage (optional — for menu images uploaded via admin) ────────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=SAME_AS_REPLIT
PRIVATE_OBJECT_DIR=SAME_AS_REPLIT
PUBLIC_OBJECT_SEARCH_PATHS=SAME_AS_REPLIT

# ── Clerk Auth ───────────────────────────────────────────────────────────────
# Get these from the Auth pane in Replit or your Clerk dashboard.
# CLERK_SECRET_KEY starts with sk_live_ or sk_test_
# CLERK_PUBLISHABLE_KEY starts with pk_live_ or pk_test_
CLERK_SECRET_KEY=SAME_AS_REPLIT
CLERK_PUBLISHABLE_KEY=SAME_AS_REPLIT

# ── Clerk — Frontend Build-Time Variables ─────────────────────────────────────
# These are baked into the frontend at build time.
# VITE_CLERK_PUBLISHABLE_KEY = same value as CLERK_PUBLISHABLE_KEY above
# VITE_CLERK_PROXY_URL = PUBLIC_URL + /api/__clerk  (e.g. http://192.168.1.50:3001/api/__clerk)
# VITE_ADMIN_PATH must match the path used in the app (do not change)
VITE_CLERK_PUBLISHABLE_KEY=SAME_AS_CLERK_PUBLISHABLE_KEY
VITE_CLERK_PROXY_URL=http://192.168.1.50:3001/api/__clerk
VITE_ADMIN_PATH=/it-admin
