<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required to keep the Presentation window alive when main screen returns to home -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:label="IT Customer Display"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            sunmi_double_screen: required by Sunmi OS to grant this app dual-screen
            control. Without it, Sunmi firmware keeps mirror mode active and blocks
            any Presentation window from being visible on the secondary display.
            Reference: https://docs.sunmi.com/en/general-function-modules/second-screen-and-customer-display/
        -->
        <meta-data
            android:name="sunmi_double_screen"
            android:value="true" />

    </application>

</manifest>
