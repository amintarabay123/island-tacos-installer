<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.islandtacos.display.debug"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="33" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for foreground service (keeps Presentation alive in background) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:label="IT Customer Display"
        android:usesCleartextTraffic="true" >
        <activity
            android:name="com.islandtacos.display.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Foreground Service that owns the Presentation on the secondary display.
            START_STICKY keeps it alive. Running as a Service means the customer
            display stays visible even when the operator switches to Chrome/POS.
        -->
        <service
            android:name="com.islandtacos.display.DisplayService"
            android:exported="false" />

        <!--
            sunmi_double_screen: grants this app dual-screen control on Sunmi OS.
            Without it, Sunmi firmware may keep mirror mode active.
            Reference: https://docs.sunmi.com/en/general-function-modules/second-screen-and-customer-display/
        -->
        <meta-data
            android:name="sunmi_double_screen"
            android:value="true" />
    </application>

</manifest>